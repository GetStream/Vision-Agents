<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- Without these the first attempt to use the microphone or dictation kills the app. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>So you can talk to the agent.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>So you can dictate a message instead of typing it.</string>
	<!--
	  The router runs over plain HTTP in local development, which App Transport Security
	  refuses by default. NSAllowsLocalNetworking permits it for local addresses only: the
	  simulator's localhost, and your Mac's address on the network when running on a device.
	  Anything on the public internet is still held to HTTPS, which is what you want.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The simulator and a device both ask before letting an app find the router on the LAN. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>To reach the acceleration router running on your Mac.</string>
</dict>
</plist>
