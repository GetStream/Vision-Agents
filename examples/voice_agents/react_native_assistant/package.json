{
  "name": "react-native-assistant",
  "version": "1.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/react-native-skia": "^2.14.0",
    "@stream-io/state-store": "^1.2.0",
    "@stream-io/stream-agents": "^0.4.3",
    "@types/jest": "30.0.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.8",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.11",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.12",
    "expo-router": "~58.0.18",
    "expo-speech": "~58.0.3",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-keyboard-controller": "1.22.9",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-teleport": "^1.2.2",
    "react-native-worklets": "0.13.0",
    "stream-chat": "^10.0.1",
    "stream-chat-expo": "10.1.0",
    "stream-chat-react-native-core": "10.1.0",
    "use-sync-external-store": "^1.7.0",
    "victory-native": "^42.0.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@types/react": "~19.3.0",
    "typescript": "6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-gesture-handler",
        "react-native-keyboard-controller"
      ]
    }
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@stream-io/.*)"
    ]
  }
}
