# Copy to .env.local (gitignored) and fill in. Public values only: Expo inlines every EXPO_PUBLIC_
# variable into the app bundle. The Stream secret stays with the token backend.

# The Stream app the Vision-Agents router runs in.
EXPO_PUBLIC_STREAM_API_KEY=YOUR_STREAM_API_KEY

# The router and its token backend (Vision-Agents' `go run ./backend`). On an Android emulator,
# `adb reverse tcp:8080 tcp:8080 && adb reverse tcp:8098 tcp:8098` makes localhost reach them.
EXPO_PUBLIC_AGENT_ROUTER_URL=http://localhost:8080
EXPO_PUBLIC_AGENT_TOKEN_URL=http://localhost:8098

# The customer and agent `go run ./configure` stored, and who this app is.
EXPO_PUBLIC_AGENT_CUSTOMER_ID=examples
EXPO_PUBLIC_AGENT_NAME=swift_assistant
EXPO_PUBLIC_AGENT_USER_ID=rn-ai-sample-user
