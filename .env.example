# Stream API credentials
STREAM_API_KEY=your_stream_api_key_here
STREAM_API_SECRET=your_stream_api_secret_here
EXAMPLE_BASE_URL=https://pronto.getstream.io

# Deepgram API credentials
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs API credentials
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional. Leave blank to use each SDK's own default voice; a placeholder here is worse
# than nothing, since it is sent upstream and rejected.
ELEVENLABS_VOICE_ID=

# OpenAI API credentials
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=model_to_use
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# Google Gemini API credentials
GOOGLE_API_KEY=your_google_api_key_here
# Alternative environment variable name (both supported)
GEMINI_API_KEY=your_gemini_api_key_here

# Cartesia API credentials
CARTESIA_API_KEY=your_cartesia_api_key_here

# Anthropic API credentials
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Roboflow API credentials
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_API_URL=your_roboflow_api_url_here

# LemonSlice API credentials
LEMONSLICE_API_KEY=your_lemonslice_api_key_here

# MiniMax API credentials
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Fish Audio API credentials, used by the Go model router's hosted S2 Pro voice
FISH_API_KEY=your_fish_api_key_here
# Optional Fish reference id to clone a voice from
FISH_VOICE_ID=

# Baseten, used by the Go model router's self-hosted Parakeet, S2 Pro and Gemma deployments,
# and by DeepSeek on the shared Model APIs, which need no deployment
BASETEN_API_KEY=your_baseten_api_key_here
PARAKEET_WS_URL=wss://model-xxxxxxx.api.baseten.co/environments/production/websocket
S2PRO_WS_URL=wss://model-xxxxxxx.api.baseten.co/environments/production/websocket
# Optional; overrides Baseten's shared Model APIs endpoint for a dedicated DeepSeek
DEEPSEEK_BASE_URL=
# The Gemma 4 deployment endpoint. Not yet deployed, see acceleration/deploy/gemma-4
GEMMA_BASE_URL=

# The Go model router itself. These replace sprint 1's STT_ROUTER_* names.
# Both stores are optional: without Postgres nothing is recorded, without Redis routing
# ignores live health.
ROUTER_ADDR=:8080
ROUTER_POSTGRES_DSN=postgres://postgres:postgres@localhost:55432/model_router?sslmode=disable
ROUTER_REDIS_ADDR=localhost:56379
# Path to a capability config; leave blank for the built-in one
ROUTER_CONFIG=
# Path to a telephony vendor list; leave blank for the built-in one
ROUTER_PHONE_CONFIG=

# mem0, what an agent remembers between calls. Without it the agent remembers nothing.
MEM0_API_KEY=your_mem0_api_key_here

# Telephony. Twilio and Telnyx are the two implemented vendors; the other nine are declared
# in acceleration/internal/phone/phone.yaml and say plainly that they are not implemented.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TELNYX_API_KEY=your_telnyx_api_key_here
# The Telnyx SIP connection numbers are routed over, needed for inbound and outbound
TELNYX_CONNECTION_ID=

# LiveKit, used by the Go model router's transcribe demo
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
