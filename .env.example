# Stream API credentials
STREAM_API_KEY=your_stream_api_key_here
STREAM_API_SECRET=your_stream_api_secret_here
EXAMPLE_BASE_URL=https://pronto.getstream.io

# Deepgram API credentials
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs API credentials
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional. Leave blank to use each SDK's own default voice; a placeholder here is worse
# than nothing, since it is sent upstream and rejected.
ELEVENLABS_VOICE_ID=

# OpenAI API credentials
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=model_to_use
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# Google Gemini API credentials
GOOGLE_API_KEY=your_google_api_key_here
# Alternative environment variable name (both supported)
GEMINI_API_KEY=your_gemini_api_key_here

# Cartesia API credentials
CARTESIA_API_KEY=your_cartesia_api_key_here

# Anthropic API credentials
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Roboflow API credentials
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_API_URL=your_roboflow_api_url_here

# LemonSlice API credentials
LEMONSLICE_API_KEY=your_lemonslice_api_key_here

# MiniMax API credentials
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Fish Audio API credentials, used by the Go model router's hosted S2 Pro voice
FISH_API_KEY=your_fish_api_key_here
# Optional Fish reference id to clone a voice from
FISH_VOICE_ID=

# Baseten, used by the Go model router's self-hosted Parakeet, S2 Pro and Gemma deployments,
# and by DeepSeek on the shared Model APIs, which need no deployment
BASETEN_API_KEY=your_baseten_api_key_here
PARAKEET_WS_URL=wss://model-xxxxxxx.api.baseten.co/environments/production/websocket
S2PRO_WS_URL=wss://model-xxxxxxx.api.baseten.co/environments/production/websocket
# Optional; overrides Baseten's shared Model APIs endpoint for a dedicated DeepSeek
DEEPSEEK_BASE_URL=
# The Gemma 4 deployment endpoint. Not yet deployed, see acceleration/deploy/gemma-4
GEMMA_BASE_URL=

# The Go model router itself. These replace sprint 1's STT_ROUTER_* names.
# Both stores are optional: without Postgres nothing is recorded, without Redis routing
# ignores live health.
ROUTER_ADDR=:8080
ROUTER_POSTGRES_DSN=postgres://postgres:postgres@localhost:55432/model_router?sslmode=disable
ROUTER_REDIS_ADDR=localhost:56379
# Path to a capability config; leave blank for the built-in one
ROUTER_CONFIG=
# Path to a telephony vendor list; leave blank for the built-in one
ROUTER_PHONE_CONFIG=
# Where this router is reachable from the internet. Two things need it. Plivo and Bandwidth
# fetch a call plan when the person answers, so without it they refuse to place a call rather
# than placing one nothing will answer. Inbound calling needs it because Stream reports an
# arriving call by webhook, and a router nothing can reach never hears about the call. In
# development this is a tunnel, e.g. ngrok http 8080. Setting it here does not register the
# webhook: run `go run ./cmd/phone hooks -url $ROUTER_PUBLIC_URL` once for that.
ROUTER_PUBLIC_URL=

# mem0, what an agent remembers between calls. Without it the agent remembers nothing.
MEM0_API_KEY=your_mem0_api_key_here

# Telephony. Eight of eleven vendors are implemented, and seven of those eight can place a
# call; the other three are declared in acceleration/internal/phone/phone.yaml and say plainly
# that they are not. Any vendor whose credentials are all set here is searched when no vendor
# is named, so setting one is enough.

# Twilio and Telnyx do everything, including answering on a number.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TELNYX_API_KEY=your_telnyx_api_key_here
# The Telnyx SIP connection numbers are routed over, needed for inbound and outbound
TELNYX_CONNECTION_ID=

# The five below buy numbers and call out on them, but do not answer on them. Several need a
# second set of credentials to place a call, because at those vendors voice is a different
# product from numbers.
SINCH_PROJECT_ID=your_sinch_project_id_here
SINCH_KEY_ID=your_sinch_key_id_here
SINCH_KEY_SECRET=your_sinch_key_secret_here
# The Sinch calling API is an application's rather than the project's
SINCH_APPLICATION_KEY=your_sinch_application_key_here
SINCH_APPLICATION_SECRET=your_sinch_application_secret_here
BANDWIDTH_ACCOUNT_ID=your_bandwidth_account_id_here
BANDWIDTH_USERNAME=your_bandwidth_username_here
BANDWIDTH_PASSWORD=your_bandwidth_password_here
# The Bandwidth sub-account an ordered number is billed and configured under
BANDWIDTH_SITE_ID=your_bandwidth_site_id_here
# The Bandwidth voice application a placed call belongs to
BANDWIDTH_APPLICATION_ID=your_bandwidth_application_id_here
VONAGE_API_KEY=your_vonage_api_key_here
VONAGE_API_SECRET=your_vonage_api_secret_here
# Vonage's voice API is JWT-authenticated by an application rather than by the api key, so
# placing a call needs these two as well. The private key is the PEM itself or a path to it.
VONAGE_APPLICATION_ID=your_vonage_application_id_here
VONAGE_PRIVATE_KEY=
# The key's own bk_{region}_ prefix decides which Bird host it is valid against
BIRD_ACCESS_KEY=your_bird_access_key_here
PLIVO_AUTH_ID=your_plivo_auth_id_here
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here

# DIDWW sells numbers and cannot place a call: it has no call control API at all, only SIP
# origination against a trunk you point your own switch at. It disables /v3/available_dids
# until you ask them to enable it.
DIDWW_API_KEY=your_didww_api_key_here

# The phone examples. OUTBOUND_TO is the handset example 13 rings. INBOUND_NUMBER is one of
# your own attached numbers, which is what you ring to reach example 14.
OUTBOUND_TO=+15550001111
INBOUND_NUMBER=

# LiveKit, used by the Go model router's transcribe demo
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
